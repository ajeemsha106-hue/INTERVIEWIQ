# ============================================================
# INTERVIEWIQ – PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================

# 1. Supabase Cloud Database & Authentication (Optional but Recommended)
# If left blank or omitted, InterviewIQ automatically uses its robust
# built-in local persistent storage engine with zero configuration.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 2. Google Gemini Generative AI (Optional)
# If provided, IQ Mentor connects directly to Gemini 1.5 Flash.
# If omitted, IQ Mentor utilizes its built-in smart context reasoning engine.
VITE_GEMINI_API_KEY=
